<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/../scripts/package.sh substitutes @VERSION@ (full, e.g. 1.0.0),
     @SHORT_VERSION@ (numeric X.Y.Z), @BUILD_SHA@ and @MIN_OS@.

     NeoDrop is a menu bar app with no Dock presence and no main menu, so LSUIElement is set.
     It is deliberately NOT sandboxed: reaching mounted network shares under /Volumes and
     writing to them is the entire point of the app, and the App Sandbox would block it. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>NeoDrop</string>
  <key>CFBundleName</key>
  <string>NeoDrop</string>
  <key>CFBundleExecutable</key>
  <string>NeoDrop</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.neodrop</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>NeoDropVersion</key>
  <string>@VERSION@</string>
  <key>NeoDropBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>NeoDrop</string>
  <!-- The Finder extension right-click menu opens this app's status window through this scheme. An
       extension cannot build the report itself — it has no engine — so it asks the app, which is the
       only thing that can answer honestly. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>ai.storyteller.neodrop.status</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>neodrop</string>
      </array>
    </dict>
  </array>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.utilities</string>
  <key>LSMinimumSystemVersion</key>
  <string>@MIN_OS@</string>
  <!-- Menu bar only: no Dock icon, no app switcher entry. -->
  <key>LSUIElement</key>
  <true/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>NeoDrop</string>
  <!-- Finder → right-click → Services → “Show NeoDrop Status”, and the same item is available for
       any file or folder so a path outside NeoDrop's folders gets an honest "not protected" answer
       instead of a missing menu item. NSMessage names the selector AppDelegate implements, and
       scripts/verify.sh checks the packaged bundle declares both it and the menu title. -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>Show NeoDrop Status</string>
      </dict>
      <key>NSMessage</key>
      <string>showFileStatus</string>
      <key>NSPortName</key>
      <string>NeoDrop</string>
      <key>NSSendFileTypes</key>
      <array>
        <string>public.item</string>
      </array>
    </dict>
  </array>
  <key>NSSupportsAutomaticTermination</key>
  <false/>
  <key>NSSupportsSuddenTermination</key>
  <false/>
</dict>
</plist>
